{
  "name": "project-iq",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/project-iq/src",
  "projectType": "application",
  "tags": ["scope:project-iq", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/project-iq"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "dev": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "project-iq:build",
        "port": 3000
      },
      "configurations": {
        "development": {
          "buildTarget": "project-iq:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "project-iq:build:production"
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "options": {
        "buildTarget": "project-iq:build",
        "port": 4300
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{workspaceRoot}/coverage/apps/project-iq"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/apps/project-iq"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/project-iq/**/*.{ts,tsx,js,jsx}"]
      }
    }
  }
}
