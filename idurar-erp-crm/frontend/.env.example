# =============================================================================
# IDURAR ERP/CRM — Frontend Environment Variables (Vite)
# Copy this file to .env and fill in your values.
#   cp frontend/.env.example frontend/.env
# See ENVIRONMENT_SETUP.md for full documentation on every variable.
#
# IMPORTANT: Only variables prefixed with VITE_ are exposed to browser code.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend API URL
# ---------------------------------------------------------------------------
# Full URL of the running backend server, including trailing slash.
# For local development this is typically http://localhost:8888/
# In production replace with your deployed backend URL.
VITE_BACKEND_SERVER="http://localhost:8888/"

# ---------------------------------------------------------------------------
# File / Media Base URL
# ---------------------------------------------------------------------------
# Public base URL from which uploaded files (PDFs, images, etc.) are served.
# Must match PUBLIC_SERVER_FILE in backend/.env.
VITE_FILE_BASE_URL="http://localhost:8888/"

# ---------------------------------------------------------------------------
# Remote Development Mode  (optional)
# ---------------------------------------------------------------------------
# Set to true to proxy Vite requests to a remote backend during local dev.
# Leave unset or false when working with a local backend instance.
# VITE_DEV_REMOTE=false
