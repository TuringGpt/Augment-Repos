DATABASE=mongodb://127.0.0.1:27017/idurar
JWT_SECRET=replace-with-a-long-random-secret
PUBLIC_SERVER_FILE=http://localhost:8888/
NODE_ENV=development
PORT=8888

# Optional: email delivery for password reset / verification flows
RESEND_API=re_replace_me

# Optional: OpenAI-backed features
OPENAI_API_KEY=

# Optional: S3-compatible uploads (DigitalOcean Spaces in current setup)
DO_SPACES_KEY=your-access-key
DO_SPACES_SECRET=your-secret-key
DO_SPACES_URL=nyc3.digitaloceanspaces.com
DO_SPACES_NAME=idurar-assets
REGION=nyc3

# Optional local workaround for OpenSSL-related issues
OPENSSL_CONF=/dev/null