# =============================================================================
# IDURAR ERP/CRM — Backend Environment Variables
# Copy this file to .env and fill in your values.
#   cp backend/.env.example backend/.env
# See ENVIRONMENT_SETUP.md for full documentation on every variable.
# =============================================================================

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Full connection URI from MongoDB Atlas → Connect → Drivers.
# Replace <password> with your database user's password.
DATABASE="mongodb+srv://<user>:<password>@cluster.mongodb.net/idurar"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Long random secret used to sign JWT tokens.
# Generate a strong one: openssl rand -hex 64
JWT_SECRET="replace_with_a_long_random_secret"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8888
NODE_ENV=development

# Public base URL where uploaded files are served (must end with /).
# In production replace with your domain, e.g. https://api.example.com/
PUBLIC_SERVER_FILE="http://localhost:8888/"

# Suppress OpenSSL configuration warnings (safe to keep as-is)
OPENSSL_CONF='/dev/null'

# ---------------------------------------------------------------------------
# File Storage — DigitalOcean Spaces (S3-compatible)
# Any S3-compatible provider works; adjust DO_SPACES_URL accordingly.
#   AWS S3:   https://s3.<region>.amazonaws.com
#   MinIO:    http://localhost:9000
# ---------------------------------------------------------------------------
DO_SPACES_KEY="your_spaces_access_key_id"
DO_SPACES_SECRET="your_spaces_secret_access_key"
DO_SPACES_NAME="your-bucket-name"
DO_SPACES_URL="https://nyc3.digitaloceanspaces.com"
REGION="nyc3"

# ---------------------------------------------------------------------------
# Email — Resend
# Get your API key at https://resend.com/api-keys
# ---------------------------------------------------------------------------
RESEND_API="re_your_resend_api_key"

# ---------------------------------------------------------------------------
# AI Features — OpenAI  (optional)
# Leave commented out if you are not using AI-powered features.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY="sk-your_openai_api_key"
